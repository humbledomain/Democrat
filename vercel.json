{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/icons/:path*", "destination": "/icons/:path*" },
    { "source": "/((?!api/|icons/|favicon\\.ico|site\\.webmanifest).*)", "destination": "/index.html" }
  ]
}
